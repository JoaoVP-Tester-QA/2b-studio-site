---
import MessageCircle from '@lucide/astro/icons/message-circle';
import { whatsappLink, site } from '../data/site';

interface Props {
  label: string;
  message?: string;
  variant?: 'solid' | 'ghost' | 'dark';
  class?: string;
  full?: boolean;
  icon?: boolean;
}
const { label, message = site.defaultMessage, variant = 'solid', class: cls = '', full = false, icon = true } = Astro.props;
---

<a
  href={whatsappLink(message)}
  class:list={['btn', variant === 'ghost' && 'btn-ghost', variant === 'dark' && 'btn-dark', full && 'w-full', cls]}
  target="_blank"
  rel="noopener"
  data-cta="whatsapp"
>
  {icon && <MessageCircle size={20} aria-hidden="true" />}
  <span>{label}</span>
  <span class="sr-only"> (abre o WhatsApp)</span>
</a>
