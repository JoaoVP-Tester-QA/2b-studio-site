---
/** Moldura mínima de navegador com a captura real do site do cliente. */
import { Image } from 'astro:assets';
import type { Case } from '../data/site';
interface Props { item: Case; class?: string }
const { item, class: cls = '' } = Astro.props;
---

<figure class:list={['overflow-hidden rounded-xs border rule-light bg-noite-2', cls]}>
  <div class="flex items-center gap-3 border-b rule-light px-3 py-2">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="size-2 rounded-full bg-nevoa/25"></span>
      <span class="size-2 rounded-full bg-nevoa/25"></span>
      <span class="size-2 rounded-full bg-nevoa/25"></span>
    </span>
    <span class="truncate text-[0.8125rem] text-apoio-escuro">{item.domain}</span>
  </div>
  <Image
    src={item.image}
    alt={item.imageAlt}
    widths={[480, 720, 1000]}
    sizes="(min-width: 768px) 640px, 100vw"
    loading="lazy"
    class:list={['block w-full object-cover object-top', item.aspect]}
  />
</figure>
