---
interface Props { class?: string; dark?: boolean }
const { class: cls = '', dark = false } = Astro.props;
---

<span class:list={['inline-flex items-baseline gap-1.5', cls]}>
  <span class="font-display text-[1.75rem] leading-none font-medium tracking-tight">2B</span>
  <span class:list={['inline-block size-[5px] rounded-full', dark ? 'bg-argila-clara' : 'bg-argila']} aria-hidden="true"></span>
  <span class="label text-[0.6875rem] tracking-[0.22em]">Studio</span>
</span>
