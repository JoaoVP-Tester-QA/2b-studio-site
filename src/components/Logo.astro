---
/**
 * Monograma 2B em traço contínuo, redesenhado em vetor a partir da logo
 * da apresentação no Canva. Trocar pelo arquivo original se houver um.
 */
interface Props { class?: string; dark?: boolean }
const { class: cls = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', cls]}>
  <svg viewBox="8 16 546 456" class="h-7 w-auto text-ciano" aria-hidden="true">
    <path
      d="M151 206 L21 206 L21 150 C21 80 80 24 150 24 C205 24 250 55 272 100 L16 388 L16 462 L258 462 M273 405 L273 462 L390 462 C480 462 545 405 545 335 C545 280 510 232 452 212 C495 195 523 158 523 115 C523 62 478 25 420 25 L272 25 L272 100"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      vector-effect="non-scaling-stroke"
    />
  </svg>
  <span class="label text-[0.6875rem] tracking-[0.22em]">Studio</span>
</span>
