---
/**
 * Logo provisório: "2B" em contorno, como na apresentação do 2B no Canva.
 * O contorno vem de um filtro (dilatar e subtrair), porque o traço direto na
 * fonte variável mostra as sobreposições internas das letras.
 * PENDENTE: trocar pelo arquivo original (SVG) quando o João enviar.
 */
interface Props { class?: string; dark?: boolean }
const { class: cls = '' } = Astro.props;
const id = `logo-outline-${Math.random().toString(36).slice(2, 8)}`;
---

<span class:list={['inline-flex items-center gap-2', cls]}>
  <svg viewBox="0 0 50 36" class="h-8 w-auto" aria-hidden="true">
    <defs>
      <filter id={id} x="-10%" y="-10%" width="120%" height="120%">
        <feMorphology in="SourceAlpha" operator="dilate" radius="0.9" result="grown" />
        <feComposite in="grown" in2="SourceAlpha" operator="out" result="ring" />
        <feFlood flood-color="#00a6d1" />
        <feComposite in2="ring" operator="in" />
      </filter>
    </defs>
    <text
      x="1"
      y="31"
      font-family="Instrument Sans Variable, sans-serif"
      font-size="38"
      font-weight="700"
      letter-spacing="0.5"
      fill="#000"
      filter={`url(#${id})`}>2B</text>
  </svg>
  <span class="label text-[0.6875rem] tracking-[0.22em]">Studio</span>
</span>
