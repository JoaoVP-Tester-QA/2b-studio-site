---
/**
 * Diagrama do hero: a página no centro e o que o 2B cuida ao redor.
 * Só usa fatos que já estão no site. Inspirado na referência Ecto enviada pelo João.
 */
const nodes = [
  { label: 'Design', x: 72, y: 11.5 },
  { label: 'Copy', x: 23.7, y: 40.4 },
  { label: 'WhatsApp', x: 92, y: 58 },
  { label: 'Instagram', x: 18.5, y: 81.5 },
  { label: 'No ar em até 7 dias', x: 64, y: 74.2 },
];
---

<div class="relative mx-auto aspect-square w-full max-w-[30rem]" aria-hidden="true">
  <svg viewBox="0 0 400 400" class="absolute inset-0 h-full w-full text-noite">
    <circle cx="200" cy="200" r="112" fill="none" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.25" stroke-dasharray="3 6" />
    <circle cx="200" cy="200" r="178" fill="none" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.25" stroke-dasharray="3 6" />
  </svg>
  <div class="absolute top-1/2 left-1/2 flex size-[34%] -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center rounded-full bg-noite text-center text-nevoa ring-1 ring-noite/40">
    <svg viewBox="8 16 546 456" class="mb-2 h-5 w-auto text-ciano">
      <path d="M151 206 L21 206 L21 150 C21 80 80 24 150 24 C205 24 250 55 272 100 L16 388 L16 462 L258 462 M273 405 L273 462 L390 462 C480 462 545 405 545 335 C545 280 510 232 452 212 C495 195 523 158 523 115 C523 62 478 25 420 25 L272 25 L272 100" fill="none" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke" />
    </svg>
    <span class="text-[0.9375rem] font-medium">Sua página</span>
  </div>
  {nodes.map((n) => (
    <span
      class="absolute -translate-x-1/2 -translate-y-1/2 whitespace-nowrap rounded-xs border border-noite/80 bg-claro px-3 py-1.5 text-[0.8125rem] font-medium text-noite"
      style={`left:${n.x}%;top:${n.y}%`}
    >{n.label}</span>
  ))}
</div>
