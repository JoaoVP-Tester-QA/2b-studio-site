---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import WhatsAppButton from './WhatsAppButton.astro';
import { packages, whatsappLink } from '../data/site';
---

<section id="pacotes" aria-labelledby="pacotes-title" class="on-dark border-t rule-light py-20 md:py-32">
  <div class="wrap">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <h2 id="pacotes-title" class="text-h2">Pouco pelo que muda no seu Instagram.</h2>
      </div>
      <p class="text-apoio-escuro md:col-span-4 md:col-start-9">Hoje o link da sua bio leva a um perfil. Com a página, ele leva a um lugar que apresenta o seu trabalho, passa confiança e termina numa conversa no WhatsApp. Preço fechado, sem letra miúda.</p>
    </div>

    <div class="grupo mt-14 grid gap-6 md:mt-20 md:grid-cols-2">
      {packages.map((p) => (
        <article
          aria-labelledby={`pkg-${p.id}`}
          class:list={[
            'cartao-pacote flex flex-col p-7 md:p-10',
            p.recommended ? 'border border-nevoa/30 bg-noite-2' : 'border rule-light bg-noite-2',
          ]}
        >
          <div class="flex min-h-[3.75rem] items-start justify-between gap-4">
            <div>
              <h3 id={`pkg-${p.id}`} class="text-h3">{p.name}</h3>
              <p class:list={['mt-1 text-small', 'text-apoio-escuro']}>{p.tagline}</p>
            </div>
            {p.recommended && <p class="text-small text-ciano">Recomendado</p>}
          </div>

          <p class="mt-10 flex items-baseline gap-2" aria-label={`${p.fromPrice ? 'a partir de ' : ''}${p.price} reais`}>
            {p.fromPrice && <span class:list={['text-small', 'text-apoio-escuro']}>a partir de</span>}
            <span class="text-[1.25rem] font-medium">R$</span>
            <span class="font-display text-[4rem] leading-none font-medium tracking-[-0.04em] tabular-nums">{p.price}</span>
          </p>

          <ul class="mt-8 border-t rule-light">
            {p.items.map((it) => (
              <li class="border-b rule-light py-3">{it}</li>
            ))}
          </ul>

          <div class="mt-auto pt-10">
            <WhatsAppButton label={p.cta} message={p.message} variant={p.recommended ? 'solid' : 'ghost'} full />
          </div>
        </article>
      ))}
    </div>

    {packages.filter((p) => p.note).map((p) => <p class="mt-8 max-w-[44rem] text-nevoa/90">{p.note}</p>)}

    <p class="mt-4 text-apoio-escuro">
      Precisa de algo diferente?{' '}
      <a href={whatsappLink('Olá! Vim pelo site do 2B Studio e tenho um projeto personalizado.')} target="_blank" rel="noopener" class="link-escuro font-semibold">
        Conte no WhatsApp e montamos uma proposta<ArrowRight size={16} class="ml-1 inline align-[-2px]" aria-hidden="true" />
      </a>
    </p>
  </div>
</section>

<style>
  .cartao-pacote {
    transition:
      translate 300ms var(--ease-2b),
      box-shadow 300ms var(--ease-2b),
      opacity 300ms var(--ease-2b);
  }
  @media (hover: hover) {
    .cartao-pacote:hover {
      translate: 0 -4px;
      box-shadow: inset 0 0 0 1px var(--color-anel);
    }
    .grupo:has(.cartao-pacote:hover) .cartao-pacote:not(:hover) {
      opacity: 0.7;
    }
  }
</style>
