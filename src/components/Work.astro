---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import CaseFrame from './CaseFrame.astro';
import { cases } from '../data/site';
---

<section id="trabalhos" aria-labelledby="trabalhos-title" class="bg-noite py-20 text-nevoa on-dark md:py-32">
  <div class="wrap">
    <h2 id="trabalhos-title" class="text-h2">Páginas que já estão no ar.</h2>

    <ol class="grupo mt-12 grid gap-8 md:mt-16 md:gap-14">
      {cases.map((c, i) => (
        <li id={c.id} class="painel grid gap-8 rounded-[20px] bg-noite-2 p-6 md:grid-cols-[1.25fr_1fr] md:items-center md:gap-14 md:p-12">
          <CaseFrame item={c} />
          <div class="flex flex-col">
            <p class="text-[0.75rem] tracking-[0.12em] text-apoio-escuro uppercase">{String(i + 1).padStart(2, '0')} · {c.segment}</p>
            <h3 class="mt-3 font-display text-[2.25rem] leading-tight font-medium">{c.name}</h3>
            <p class="mt-4 text-[1.0625rem] leading-normal text-apoio-escuro">{c.summary}</p>
            <p class="mt-3 text-[0.8125rem] text-apoio-escuro">
              <span class="sr-only">Entregas: </span>{c.deliverables.join(' · ')}
            </p>
            <blockquote class="mt-8">
              <p class="text-[1.5rem] leading-[1.35] font-medium tracking-[-0.01em]">“{c.quote}”</p>
              <footer class="mt-3.5 text-small text-apoio-escuro">
                <span class="font-medium text-nevoa">{c.author}</span>, {c.authorRole}
              </footer>
            </blockquote>
            <a href={c.url} target="_blank" rel="noopener" class="link-escuro link-arrow mt-8 self-start">
              Ver o site <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> {c.domain} (abre em nova aba)</span>
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .painel :global(figure) {
    transition: translate 350ms var(--ease-2b);
  }
  .painel {
    transition: opacity 300ms var(--ease-2b);
  }
  @media (hover: hover) {
    .painel:hover :global(figure) {
      translate: 0 -4px;
    }
    .grupo:has(.painel:hover) .painel:not(:hover) {
      opacity: 0.7;
    }
  }
</style>
