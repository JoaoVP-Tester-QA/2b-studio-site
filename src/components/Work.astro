---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import CaseFrame from './CaseFrame.astro';
import { cases } from '../data/site';
---

<section id="trabalhos" aria-labelledby="trabalhos-title" class="bg-noite-2 py-20 text-nevoa on-dark md:py-32">
  <div class="wrap">
    <div class="max-w-3xl">
      <h2 id="trabalhos-title" class="text-h2">Páginas que já estão no ar.</h2>
    </div>

    <ol class="mt-14 grid gap-20 md:mt-20 md:gap-28">
      {cases.map((c, i) => (
        <li id={c.id} class="reveal grid gap-8 md:grid-cols-12 md:gap-10">
          <div class:list={['md:col-span-7', i % 2 === 1 && 'md:order-2']}>
            <CaseFrame item={c} class="border-nevoa/15" />
          </div>
          <div class:list={['flex flex-col md:col-span-5', i % 2 === 1 && 'md:order-1']}>
            <p class="text-small text-apoio-escuro">{c.segment}</p>
            <h3 class="mt-2 font-display text-[2.25rem] leading-tight">{c.name}</h3>
            <p class="mt-4 text-nevoa/90">{c.summary}</p>
            <p class="mt-4 text-small text-apoio-escuro">
              <span class="sr-only">Entregas: </span>{c.deliverables.join(' · ')}
            </p>
            <blockquote class="mt-8 border-l-2 border-ciano pl-5">
              <p class="text-[1.25rem] leading-snug">“{c.quote}”</p>
              <footer class="mt-3 text-small text-apoio-escuro">{c.author}, {c.authorRole}</footer>
            </blockquote>
            <a href={c.url} target="_blank" rel="noopener" class="link-arrow mt-8 self-start text-ciano">
              Ver o site <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> {c.domain} (abre em nova aba)</span>
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
