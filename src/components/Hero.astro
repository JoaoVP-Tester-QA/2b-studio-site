---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { Image } from 'astro:assets';
import dupla from '../assets/dupla.jpg';
import { cases, site, whatsappLink } from '../data/site';
---

<section id="topo" aria-labelledby="hero-title" class="on-dark pt-10 pb-16 md:pt-20 md:pb-28" data-hero>
  <div class="wrap grid gap-12 md:grid-cols-12 md:items-end md:gap-8">
    <div class="md:col-span-7">
      <p class="label text-apoio-escuro">2B Studio · Tremembé, SP</p>
      <h1 id="hero-title" class="mt-5 text-display">Design e texto para negócios locais.</h1>
      <p class="mt-6 max-w-[34rem] text-[1.1875rem] leading-relaxed text-apoio-escuro">
        Somos o João e o Miguel. Um cuida do design, o outro da copy, e os dois acompanham cada projeto do
        briefing até a página no ar.
      </p>
      <div class="mt-9 flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-8">
        <a href="#trabalhos" class="btn w-full sm:w-auto">Ver trabalhos</a>
        <a
          href={whatsappLink(site.defaultMessage)}
          target="_blank"
          rel="noopener"
          data-cta="whatsapp"
          class="link-arrow self-start sm:self-auto"
          >Conversar no WhatsApp <ArrowRight size={18} aria-hidden="true" /><span class="sr-only"> (abre o WhatsApp)</span></a
        >
      </div>
      <p class="mt-10 border-t rule-light pt-5 text-small text-apoio-escuro">
        Páginas no ar para{' '}
        {cases.map((c, i) => (
          <>
            <a href={`#${c.id}`} class="font-medium text-nevoa underline underline-offset-4">{c.name}</a>
            {i < cases.length - 1 ? ' e ' : '.'}
          </>
        ))}
      </p>
    </div>
    <figure class="md:col-span-5">
      <Image
        src={dupla}
        alt="João e Miguel, sócios do 2B Studio, lado a lado e sorrindo."
        widths={[400, 640, 1000]}
        sizes="(min-width: 768px) 40vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-square w-full rounded-xs object-cover"
      />
    </figure>
  </div>
</section>
