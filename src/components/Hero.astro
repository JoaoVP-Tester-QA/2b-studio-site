---
import HeroConstrucao from './HeroConstrucao.astro';
import WhatsAppButton from './WhatsAppButton.astro';
---

<section id="topo" aria-labelledby="hero-title" class="heroi on-dark relative overflow-hidden" data-hero>
  <div class="wrap relative grid gap-12 pt-10 pb-16 md:grid-cols-[1fr_1.2fr] md:items-center md:gap-14 md:pt-[4.5rem] md:pb-[7.5rem]">
    <div class="pt-6 md:pt-0">
      <h1 id="hero-title" class="text-[2.5rem] leading-[1.08] font-medium whitespace-nowrap sm:text-[3.5rem] md:text-[2.625rem] lg:text-[3.5rem] xl:text-[4rem]">
        <span class="block">Sua marca.</span>
        <span class="block text-ciano">Sua presença.</span>
        <span class="block">Seu próximo nível.</span>
      </h1>
      <p class="mt-6 max-w-[30rem] text-[1.125rem] leading-relaxed text-apoio-escuro">
        Landing pages para negócios locais, feitas por dois irmãos: um no design, o outro no texto.
      </p>
      <WhatsAppButton label="Quero minha página" icon={false} class="mt-9 w-full sm:w-auto" />
    </div>
    <div class="relative">
      <p class="sr-only">Ilustração de uma página sendo desenhada: tipografia, cores e texto.</p>
      <HeroConstrucao />
    </div>
  </div>

  <a href="#trabalhos" class="dica absolute bottom-7 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-1 md:flex" aria-label="Rolar para ver os trabalhos">
    <svg class="mouse" width="28" height="44" viewBox="0 0 28 44" fill="none" aria-hidden="true">
      <rect x="1" y="1" width="26" height="42" rx="13" stroke="#93a3b1" stroke-width="1.5"></rect>
      <rect class="roda pulsa" x="12" y="9" width="4" height="9" rx="2" fill="#00a6d1"></rect>
    </svg>
    <svg width="16" height="22" viewBox="0 0 16 22" fill="none" aria-hidden="true">
      <path class="seta s1 pulsa" d="M3 3.5 8 8.5 13 3.5" stroke="#00a6d1" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
      <path class="seta s2 pulsa" d="M3 11.5 8 16.5 13 11.5" stroke="#00a6d1" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</section>

<style>
  @media (min-width: 48rem) {
    .heroi {
      display: flex;
      align-items: center;
      min-height: max(719px, calc(100svh - 81px));
    }
  }
  .dica .mouse rect:first-child {
    transition: stroke 200ms var(--ease-2b);
  }
  .dica:hover .mouse rect:first-child {
    stroke: #e8eef2;
  }
  .seta {
    opacity: 0.35;
  }
  /* Sem deslocamento: só a opacidade pulsa, para quem pede menos movimento. */
  .roda,
  .s1,
  .s2 {
    animation: acender 1.6s ease-in-out infinite;
  }
  .s1 { animation-delay: 0.2s; }
  .s2 { animation-delay: 0.4s; }
  @media (prefers-reduced-motion: no-preference) {
    .roda {
      animation: rolar 1.6s var(--ease-2b) infinite;
    }
    .s1,
    .s2 {
      animation: cascata 1.6s ease-in-out infinite;
    }
    .s1 { animation-delay: 0.2s; }
    .s2 { animation-delay: 0.4s; }
  }
  @keyframes rolar {
    0% { translate: 0 0; opacity: 1; }
    60% { translate: 0 10px; opacity: 0; }
    61% { translate: 0 0; opacity: 0; }
    100% { translate: 0 0; opacity: 1; }
  }
  @keyframes cascata {
    0%, 100% { opacity: 0.25; translate: 0 -2px; }
    50% { opacity: 1; translate: 0 2px; }
  }
  @keyframes acender {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }
</style>
