---
/**
 * Lado direito do hero: uma página de exemplo em navegador e celular,
 * com cartões flutuantes de benefícios (referência enviada pelo João,
 * conceitos "website em destaque" + "composição 3D"). Mostra recortes
 * reais dos trabalhos, sem legenda, para não repetir a seção Trabalhos.
 */
import Smartphone from '@lucide/astro/icons/smartphone';
import Clock from '@lucide/astro/icons/clock';
import PenTool from '@lucide/astro/icons/pen-tool';
import Type from '@lucide/astro/icons/type';
import { Image } from 'astro:assets';
import colinaImg from '../assets/colina.jpg';

const cards = [
  { label: 'No ar em até 7 dias', icon: Clock, pos: 'top-[0%] right-[0%]', delay: '0s' },
  { label: 'Design profissional', icon: PenTool, pos: 'top-[0%] left-[0%]', delay: '-2s' },
  { label: 'Texto claro', icon: Type, pos: 'bottom-[10%] right-[4%]', delay: '-4s' },
  { label: 'Feita para o celular', icon: Smartphone, pos: 'bottom-[-2%] left-[6%]', delay: '-1s' },
];
---

<div class="mockup relative mx-auto aspect-[10/9] w-full max-w-[34rem]" aria-hidden="true">
  <div class="mockup-stage absolute inset-0">
    <!-- Navegador -->
    <div class="absolute top-[10%] right-[4%] left-[10%] overflow-hidden rounded-md border border-noite/70 bg-noite shadow-[0_40px_80px_-30px_rgba(4,19,31,0.65)]">
      <div class="flex items-center gap-1.5 border-b border-white/10 px-3 py-2">
        <span class="size-2 rounded-full bg-white/25"></span>
        <span class="size-2 rounded-full bg-white/25"></span>
        <span class="size-2 rounded-full bg-white/25"></span>
        <span class="ml-3 truncate rounded-xs bg-white/8 px-2.5 py-0.5 text-[0.6875rem] text-apoio-escuro">colinadoleao.com</span>
      </div>
      <Image
        src={colinaImg}
        alt=""
        widths={[480, 720, 1000]}
        sizes="(min-width: 768px) 30rem, 90vw"
        loading="eager"
        class="block aspect-[16/10] w-full object-cover object-top"
      />
    </div>

    <!-- Celular -->
    <div class="absolute bottom-[6%] left-[2%] w-[27%] rounded-[1rem] border border-noite bg-noite p-[1.5%] shadow-[0_30px_60px_-20px_rgba(4,19,31,0.7)]">
      <Image
        src={colinaImg}
        alt=""
        widths={[480]}
        sizes="10rem"
        loading="eager"
        class="block aspect-[9/17] w-full rounded-[0.75rem] object-cover object-[0%_50%]"
      />
    </div>
  </div>

  {cards.map(({ label, icon: Icon, pos, delay }) => (
    <span
      class:list={['float-card absolute flex items-center gap-2 whitespace-nowrap rounded-xs border border-noite/80 bg-claro px-2.5 py-1.5 text-[0.75rem] sm:px-3 sm:py-2 sm:text-[0.8125rem] font-medium text-noite shadow-[0_14px_30px_-14px_rgba(4,19,31,0.6)]', pos]}
      style={`animation-delay:${delay}`}
    >
      <Icon size={15} class="text-ciano-escuro" />
      {label}
    </span>
  ))}
</div>

<style>
  .mockup {
    perspective: 1400px;
  }
  .mockup-stage {
    transform: rotateY(-10deg) rotateX(5deg);
    transform-style: preserve-3d;
  }
  @media (prefers-reduced-motion: no-preference) {
    .float-card {
      animation: flutuar 6s ease-in-out infinite;
    }
  }
  @keyframes flutuar {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -6px;
    }
  }
</style>
