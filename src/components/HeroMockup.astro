---
/**
 * Lado direito do hero: uma página de exemplo em navegador e celular,
 * com cartões flutuantes de benefícios (referência enviada pelo João,
 * conceitos "website em destaque" + "composição 3D"). Não usa fotos dos
 * trabalhos, que já têm a seção própria.
 */
import Smartphone from '@lucide/astro/icons/smartphone';
import Clock from '@lucide/astro/icons/clock';
import PenTool from '@lucide/astro/icons/pen-tool';
import Type from '@lucide/astro/icons/type';

const cards = [
  { label: 'No ar em até 7 dias', icon: Clock, pos: 'top-[30%] right-[-3%]', delay: '0s' },
  { label: 'Design profissional', icon: PenTool, pos: 'top-[0%] left-[2%]', delay: '-2s' },
  { label: 'Texto claro', icon: Type, pos: 'bottom-[10%] right-[4%]', delay: '-4s' },
  { label: 'Feita para o celular', icon: Smartphone, pos: 'bottom-[-2%] left-[6%]', delay: '-1s' },
];
---

<div class="mockup relative mx-auto aspect-[10/9] w-full max-w-[34rem]" aria-hidden="true">
  <div class="mockup-stage absolute inset-0">
    <!-- Navegador -->
    <div class="absolute top-[10%] right-[4%] left-[10%] overflow-hidden rounded-md border border-noite/70 bg-noite shadow-[0_40px_80px_-30px_rgba(4,19,31,0.65)]">
      <div class="flex items-center gap-1.5 border-b border-white/10 px-3 py-2">
        <span class="size-2 rounded-full bg-white/25"></span>
        <span class="size-2 rounded-full bg-white/25"></span>
        <span class="size-2 rounded-full bg-white/25"></span>
        <span class="ml-3 truncate rounded-xs bg-white/8 px-2.5 py-0.5 text-[0.6875rem] text-apoio-escuro">seunegocio.com.br</span>
      </div>
      <div class="p-[6%]">
        <div class="flex items-center justify-between">
          <span class="h-2 w-[18%] rounded-full bg-white/40"></span>
          <span class="flex gap-2">
            <span class="h-1.5 w-6 rounded-full bg-white/20"></span>
            <span class="h-1.5 w-6 rounded-full bg-white/20"></span>
            <span class="h-1.5 w-6 rounded-full bg-white/20"></span>
          </span>
        </div>
        <div class="mt-[8%] grid grid-cols-5 items-center gap-[6%]">
          <div class="col-span-3">
            <span class="block h-3 w-[90%] rounded-full bg-nevoa"></span>
            <span class="mt-2 block h-3 w-[70%] rounded-full bg-ciano"></span>
            <span class="mt-3 block h-1.5 w-full rounded-full bg-white/20"></span>
            <span class="mt-1.5 block h-1.5 w-[80%] rounded-full bg-white/20"></span>
            <span class="mt-4 block h-5 w-[45%] rounded-xs bg-ciano"></span>
          </div>
          <div class="col-span-2 aspect-[4/5] rounded-sm bg-gradient-to-br from-noite-2 via-[#123447] to-ciano-escuro"></div>
        </div>
        <div class="mt-[8%] grid grid-cols-3 gap-2">
          <span class="h-9 rounded-xs bg-white/8"></span>
          <span class="h-9 rounded-xs bg-white/8"></span>
          <span class="h-9 rounded-xs bg-white/8"></span>
        </div>
      </div>
    </div>

    <!-- Celular -->
    <div class="absolute bottom-[6%] left-[2%] w-[27%] rounded-[1rem] border border-noite bg-noite p-[1.5%] shadow-[0_30px_60px_-20px_rgba(4,19,31,0.7)]">
      <div class="overflow-hidden rounded-[0.75rem] bg-noite-2 px-[10%] pt-[18%] pb-[14%]">
        <span class="mx-auto mb-[16%] block h-1 w-[30%] rounded-full bg-white/25"></span>
        <span class="block h-2 w-[90%] rounded-full bg-nevoa"></span>
        <span class="mt-1.5 block h-2 w-[65%] rounded-full bg-ciano"></span>
        <span class="mt-3 block h-1 w-full rounded-full bg-white/20"></span>
        <span class="mt-1 block h-1 w-[80%] rounded-full bg-white/20"></span>
        <span class="mt-3 block aspect-[4/3] w-full rounded-xs bg-gradient-to-br from-[#123447] to-ciano-escuro"></span>
        <span class="mt-3 block h-3.5 w-full rounded-xs bg-ciano"></span>
      </div>
    </div>
  </div>

  {cards.map(({ label, icon: Icon, pos, delay }) => (
    <span
      class:list={['float-card absolute flex items-center gap-2 whitespace-nowrap rounded-xs border border-noite/80 bg-claro px-3 py-2 text-[0.8125rem] font-medium text-noite shadow-[0_14px_30px_-14px_rgba(4,19,31,0.6)]', pos]}
      style={`animation-delay:${delay}`}
    >
      <Icon size={15} class="text-ciano-escuro" />
      {label}
    </span>
  ))}
</div>

<style>
  .mockup {
    perspective: 1400px;
  }
  .mockup-stage {
    transform: rotateY(-10deg) rotateX(5deg);
    transform-style: preserve-3d;
  }
  @media (prefers-reduced-motion: no-preference) {
    .float-card {
      animation: flutuar 6s ease-in-out infinite;
    }
  }
  @keyframes flutuar {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -6px;
    }
  }
</style>
