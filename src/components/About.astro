---
import { Image } from 'astro:assets';
import dupla from '../assets/dupla-recorte.png';
import { site } from '../data/site';

---

<section id="sobre" aria-labelledby="sobre-title" class="on-dark overflow-hidden bg-noite-2 pt-20 md:pt-24">
  <div class="wrap grid gap-12 md:grid-cols-[1fr_1.05fr] md:items-end md:gap-[4.5rem]">
    <div class="md:pb-24">
      <h2 id="sobre-title" class="text-h2 md:text-[3rem]">Dois irmãos, um estúdio pequeno de propósito.</h2>
      <p class="mt-6 max-w-[32.5rem] text-[1.1875rem] leading-[1.55]">
        O 2B é o João e o Miguel, irmãos e fundadores, de {site.city}. Um cuida do design, o outro do texto, e
        nenhuma página vai para o ar sem passar pelas mãos dos dois.
      </p>
    </div>
    <figure class="flex items-end justify-center md:justify-end">
      <Image
        src={dupla}
        alt="João e Miguel, irmãos e fundadores do 2B Studio, lado a lado e sorrindo."
        widths={[480, 720, 1080]}
        sizes="(min-width: 768px) 40rem, 100vw"
        class="block h-auto w-full max-w-[40rem]"
      />
    </figure>
  </div>
</section>
