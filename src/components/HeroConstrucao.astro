---
/**
 * Lado direito do hero: uma página genérica "sendo construída", como numa
 * ferramenta de design. Grid, seleção no título, régua de espaçamento,
 * tipografia e cores. Remete ao serviço (design + texto) sem repetir os
 * trabalhos da seção Trabalhos e sem imagem de banco. Tudo em CSS.
 */
---

<div class="cena relative mx-auto aspect-square w-full max-w-[34rem]" aria-hidden="true">
  <!-- Grid de fundo -->
  <div class="grade absolute inset-0"></div>

  <!-- Página -->
  <div class="pagina absolute top-[16%] right-[4%] left-[8%] ">
    <div class="nav">
      <span class="marca"></span>
      <span class="ml-auto flex gap-[3cqw]"><i></i><i></i><i></i></span>
      <span class="pill"></span>
    </div>

    <div class="corpo">
      <div class="col-texto">
        <span class="sobretitulo"></span>
        <div class="selecao">
          <p class="titulo">Seu negócio,<br />bem apresentado.<span class="cursor"></span></p>
          <b class="h tl"></b><b class="h tr"></b><b class="h bl"></b><b class="h br"></b>
          <span class="dim">W 100%</span>
        </div>
        <span class="linha mt-[4.2cqw] w-[92%]"></span>
        <span class="linha w-[70%]"></span>
        <span class="botao">Fale com a gente</span>
      </div>
      <div class="col-imagem">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="h-full w-full">
          <path d="M0 78 L28 50 L44 64 L66 38 L100 72 L100 100 L0 100 Z" fill="currentColor" opacity="0.35" />
          <circle cx="74" cy="24" r="7" fill="currentColor" opacity="0.5" />
        </svg>
      </div>
    </div>

    <div class="cards">
      <span></span><span></span><span></span>
    </div>

    <!-- Régua de espaçamento -->
    <div class="regua"><span>48</span></div>
  </div>

  <!-- Cartão: tipografia -->
  <div class="cartao absolute top-[3%] left-0">
    <span class="aa">Aa</span>
    <span class="flex flex-col">
      <span class="rotulo">Tipografia</span>
      <span class="valor">Títulos e textos</span>
    </span>
  </div>

  <!-- Cartão: cores -->
  <div class="cartao absolute right-0 bottom-[4%]">
    <span class="flex flex-col">
      <span class="rotulo">Cores</span>
      <span class="valor">Da sua marca</span>
    </span>
    <span class="flex gap-[1.2cqw]">
      <span class="bola" style="background:#0b1f2e"></span>
      <span class="bola" style="background:#00a6d1"></span>
      <span class="bola" style="background:#e8eef2"></span>
    </span>
  </div>
</div>

<style>
  .cena {
    container-type: inline-size;
  }
  .grade {
    background-image:
      linear-gradient(to right, rgb(0 166 209 / 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(0 166 209 / 0.07) 1px, transparent 1px);
    background-size: 8.33% 8.33%;
    mask-image: radial-gradient(closest-side, #000 55%, transparent);
  }
  .pagina {
    display: flex;
    flex-direction: column;
    gap: 4cqw;
    padding: 4cqw 4.5cqw;
    border-radius: 6px;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: var(--color-noite-2);
    box-shadow: 0 50px 100px -40px rgb(0 0 0 / 0.9);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 3cqw;
  }
  .marca {
    width: 5cqw;
    height: 2.2cqw;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.5);
  }
  .nav i {
    display: block;
    width: 6cqw;
    height: 1cqw;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.18);
  }
  .pill {
    width: 10cqw;
    height: 3.2cqw;
    border-radius: 999px;
    background: var(--color-ciano);
  }
  .corpo {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 4cqw;
    align-items: center;
  }
  .col-texto {
    display: flex;
    flex-direction: column;
    gap: 1.8cqw;
  }
  .sobretitulo {
    width: 14cqw;
    height: 1cqw;
    border-radius: 9px;
    background: color-mix(in srgb, var(--color-ciano) 70%, transparent);
  }
  .selecao {
    position: relative;
    margin: 0.6cqw 0 1cqw;
    outline: 1px solid var(--color-ciano);
    outline-offset: 1.2cqw;
  }
  .titulo {
    font-size: 4.7cqw;
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-nevoa);
  }
  .cursor {
    display: inline-block;
    width: 2px;
    height: 0.9em;
    margin-left: 2px;
    vertical-align: -0.08em;
    background: var(--color-ciano);
  }
  .h {
    position: absolute;
    width: 1.4cqw;
    height: 1.4cqw;
    background: var(--color-noite);
    border: 1px solid var(--color-ciano);
  }
  .tl { top: calc(-1.2cqw - 0.7cqw); left: calc(-1.2cqw - 0.7cqw); }
  .tr { top: calc(-1.2cqw - 0.7cqw); right: calc(-1.2cqw - 0.7cqw); }
  .bl { bottom: calc(-1.2cqw - 0.7cqw); left: calc(-1.2cqw - 0.7cqw); }
  .br { bottom: calc(-1.2cqw - 0.7cqw); right: calc(-1.2cqw - 0.7cqw); }
  .dim {
    position: absolute;
    left: 50%;
    bottom: calc(-1.2cqw - 3.4cqw);
    translate: -50% 0;
    padding: 0.2cqw 1cqw;
    border-radius: 2px;
    background: var(--color-ciano);
    color: var(--color-noite);
    font-size: 1.7cqw;
    font-weight: 600;
    white-space: nowrap;
  }
  .linha {
    display: block;
    height: 1cqw;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.16);
  }
  .botao {
    align-self: flex-start;
    margin-top: 1.2cqw;
    padding: 1.2cqw 2.6cqw;
    border-radius: 999px;
    background: var(--color-ciano);
    color: var(--color-noite);
    font-size: 1.9cqw;
    font-weight: 600;
  }
  .col-imagem {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    color: var(--color-ciano);
    background: linear-gradient(160deg, rgb(0 166 209 / 0.28), rgb(0 166 209 / 0.05));
    border: 1px solid rgb(0 166 209 / 0.25);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.4cqw;
  }
  .cards span {
    height: 7cqw;
    border-radius: 3px;
    border: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(255 255 255 / 0.04);
  }
  .regua {
    position: absolute;
    top: 13%;
    bottom: 47%;
    left: -3.4cqw;
    width: 1.4cqw;
    border-block: 1px solid rgb(0 166 209 / 0.7);
  }
  .regua::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 50%;
    border-left: 1px dashed rgb(0 166 209 / 0.7);
  }
  .regua span {
    position: absolute;
    top: 50%;
    right: 2cqw;
    translate: 0 -50%;
    font-size: 1.7cqw;
    font-weight: 600;
    color: var(--color-ciano);
  }
  .cartao {
    display: flex;
    align-items: center;
    gap: 2.6cqw;
    padding: 2.2cqw 3cqw;
    border-radius: 4px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: color-mix(in srgb, var(--color-noite) 85%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 18px 36px -18px rgb(0 0 0 / 0.8);
  }
  .aa {
    font-size: 6.4cqw;
    line-height: 1;
    font-weight: 500;
    color: var(--color-nevoa);
  }
  .rotulo {
    font-size: max(0.625rem, 1.9cqw);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ciano);
  }
  .valor {
    margin-top: 0.3em;
    font-size: max(0.75rem, 2.5cqw);
    color: var(--color-nevoa);
  }
  .bola {
    width: 4.2cqw;
    height: 4.2cqw;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: piscar 1.1s steps(1) infinite;
    }
    .cartao {
      animation: flutuar 6s ease-in-out infinite;
    }
    .cartao:last-child {
      animation-delay: -3s;
    }
  }
  @keyframes piscar {
    50% { opacity: 0; }
  }
  @keyframes flutuar {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -6px; }
  }
</style>
